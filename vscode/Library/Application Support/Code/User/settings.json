{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.printWidth": 120,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.rulers": [88],
    "rewrap.autoWrap.enabled": true,
    "rewrap.wrappingColumn": 72,
    "editor.formatOnType": true,
  },
  "cSpell.userWords": [
    "autopep",
    "Coalescer",
    "cooldown",
    "datetime",
    "devcontainer",
    "dotenv",
    "esbenp",
    "figsize",
    "gcloud",
    "gloud",
    "Insertable",
    "iterrows",
    "jsons",
    "kevbot",
    "Keybind",
    "Keybinds",
    "Kuney",
    "kysely",
    "levelname",
    "logix",
    "networkx",
    "NOFILL",
    "openpyxl",
    "Permissives",
    "Pipenv",
    "pylint",
    "rslogix",
    "setpoint",
    "setpoints",
    "setuptools",
    "sheetnames",
    "Updateable",
    "xdot",
    "xlutils",
    "xlwt",
    "yapf",
  ],
  "editor.minimap.enabled": false,
  "cSpell.ignoreWords": ["Ffprobe"],
  "explorer.confirmDragAndDrop": false,
  "redhat.telemetry.enabled": true,
  "editor.renderWhitespace": "all",
  "black-formatter.args": ["--preview", "--enable-unstable-feature", "string_processing"],
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "flake8.args": ["--max-line-length=88", "--extend-ignore=E203"],
  "[dotenv]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
  },
  "diffEditor.hideUnchangedRegions.enabled": true,
  "github-actions.workflows.pinned.workflows": [],
  "gitlens.rebaseEditor.ordering": "asc",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "docker.extension.enableComposeLanguageServer": false,
  // "terminal.external.osxExec": "/usr/local/bin/wezterm",
  // "terminal.integrated.commandsToSkipShell": ["matlab.interrupt"]
  "workbench.colorTheme": "Dark Modern",
  "explorer.confirmDelete": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.automationProfile.osx": {
    "path": "/bin/zsh",
  },
  "editor.lineNumbers": "relative",
  "git.confirmSync": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["g", "D"],
      "commands": ["editor.action.goToDeclaration"],
    },
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"],
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.referenceSearch.trigger"],
    },
    {
      "before": ["g", "y"],
      "commands": ["editor.action.goToTypeDefinition"],
    },
    {
      "before": ["K"],
      "commands": ["editor.action.showHover"],
    },
  ],
}
